{
  "name": "an-coffee",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node dist/AnCoffee/server/server.mjs",
    "start:dev": "ng serve --proxy-config proxy.conf.json",
    "dev": "node scripts/dev.js",
    "build": "ng build && cp -n dist/an-coffee/browser/index.csr.html dist/an-coffee/browser/index.html || true",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "optimize:images": "node scripts/optimize-images.js",
    "test": "ng test",
    "serve:ssr:AnCoffee": "node dist/AnCoffee/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-server": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@angular/ssr": "^21.2.11",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.26",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "autoprefixer": "^10.5.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
